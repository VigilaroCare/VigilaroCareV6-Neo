# ============================================================
# Vigilaro API Proxy — Template de Variáveis de Ambiente
# ============================================================
# Copie para .env e preencha com suas chaves reais:
#   cp .env.example .env
#
# Em produção (Vercel), configure via dashboard:
#   Vercel → Settings → Environment Variables
# ============================================================

# OpenAI API Key (obrigatória)
# Gere em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-XXXXXXXX

# ElevenLabs API Key (opcional — TTS avançado)
# Gere em: https://elevenlabs.io/api
ELEVEN_API_KEY=

# EPA CTX API Key (opcional — dados toxicológicos)
# Solicite em: https://api-ccte.epa.gov/docs/
EPA_CTX_API_KEY=

# Token de acesso do app ao proxy (obrigatório)
# Este mesmo valor deve estar no .env do app como EXPO_PUBLIC_VIGILARO_PROXY_TOKEN
VIGILARO_PROXY_TOKEN=your-secure-token-here
VIGILARO_APP_SECRET=your-secure-token-here

# ============================================================
# MÓDULO CUIDADOR REMOTO — SMS / WhatsApp
# Configure ao menos UMA das opções abaixo (Zenvia recomendado para BR)
# ============================================================

# Zenvia (https://zenvia.com) — parceiro oficial Meta no Brasil
# Após criar conta e aprovar número WhatsApp Business:
ZENVIA_TOKEN=
ZENVIA_FROM_WHATSAPP=+55119XXXXXXXX
ZENVIA_FROM_SMS=+55119XXXXXXXX

# Twilio (https://twilio.com) — alternativa internacional / Sandbox para testes
# Sandbox WhatsApp: https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15XXXXXXXXXX
