# ============================================================
# Vigilaro Care — Variáveis de Ambiente do App (Mobile Client)
# ============================================================
# Copie para .env e preencha:
#   cp .env.example .env
#
# ⚠️ SEGURANÇA: Variáveis EXPO_PUBLIC_* são embarcadas no bundle JS.
# NUNCA coloque chaves privadas (OpenAI, ElevenLabs) aqui.
# Chaves privadas vivem EXCLUSIVAMENTE no backend-proxy/.env
# ============================================================

# Ambiente
EXPO_PUBLIC_ENV=production

# Proxy URL — em produção, use a URL do Vercel deploy
# Em dev local, use http://localhost:3000
EXPO_PUBLIC_VIGILARO_PROXY_URL=https://your-proxy.vercel.app

# Token publico de acesso ao proxy (NAO e chave OpenAI e NAO e segredo forte).
# O valor fica embarcado no app; use apenas como barreira leve, com rate limit
# e monitoramento no backend. Chaves privadas ficam no backend-proxy/.env.
EXPO_PUBLIC_VIGILARO_PROXY_TOKEN=replace-with-public-client-token

# Feature flags
EXPO_PUBLIC_USE_MOCK_VISION=false
EXPO_PUBLIC_ENABLE_REALTIME_VOICE=false

# RevenueCat (In-App Purchases)
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# Porta do proxy local (dev only)
PORT=3000
